# Optional environment of orchestrator-multitenant.service.
# Install as /etc/orchestrator/orchestrator-multitenant.env (owner orchestrator, mode 0600).
#
# Flags passed to the orchestrator binary before "http": --verbose (INFO), --debug (very verbose), --quiet.
ORC_ARGS=--verbose
#
# Do NOT put topology or backend passwords here: hooks run by orchestrator inherit this environment, so every
# tenant's hooks could read them. Use MySQLTopologyCredentialsConfigFile per tenant instead.
