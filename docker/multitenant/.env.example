# Copy to .env (chmod 0600) and edit. docker compose reads it automatically.
# Nothing in this file is baked into an image or into a compose file.

# Image to run (built from the repository root by `docker compose build`)
ORCHESTRATOR_IMAGE=orchestrator-mt:local

# Memory cap of every orchestrator container. 384m is enough for 3 tenants of a few instances each;
# raise it with the number of monitored instances (an OOM kill of the leader triggers a re-election).
ORC_MEM_LIMIT=384m

# Topology password of the tenant "mariadb-b", expanded from ${ORC_B_TOPOLOGY_PASSWORD} in config/*/tenants*.json.
# WARNING: recovery hooks inherit the whole environment of the orchestrator process, so every tenant's hooks can read
# this. For tenants that do not trust each other use a credentials file (see secrets.example/) instead.
ORC_B_TOPOLOGY_PASSWORD=change-me-b

